# =============================================================================
# VoxAID Environment Variables
# Copy to .env and fill in all values
# For AWS deploy: the deploy script reads .env automatically
# =============================================================================

# --- Database (Supabase Postgres) ---
# NOT the API keys page — you need the database connection string.
# Get from: Supabase Dashboard → Click "Connect" (green button, top bar)
#   → Choose "ORMs" tab → Copy the URI for Prisma
# Or: Project Settings → Database → Connection string → URI tab
# Replace [YOUR-PASSWORD] with your database password (set when creating the project).
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.co:5432/postgres

# --- Auth (Clerk) ---
# Get from: https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- Voice (Twilio) ---
# Get from: https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...
# Public-facing voice number shown on the landing page "Try it now" card.
# Format as you want it displayed, e.g. "+1 (415) 555-0123".
NEXT_PUBLIC_DEMO_VOICE_NUMBER=+1 (415) 555-0123

# --- ASR (Groq Whisper — free, no credit card needed) ---
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# --- Speech-to-text (Deepgram Nova-3) ---
# Get from: https://console.deepgram.com → API Keys
# $200 free credit on signup, no credit card required
DEEPGRAM_API_KEY=...

# --- LLM (Action Plans) ---
# Option 1: Anthropic Claude (best quality, requires billing)
# Get from: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
#
# Option 2: Leave ANTHROPIC_API_KEY empty → auto-falls back to Groq Llama 3.3 (free)
# Uses the same GROQ_API_KEY above, no extra key needed

# --- TTS (ElevenLabs) ---
# Get from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=...

# --- File Storage (Cloudflare R2) ---
# Get from: https://dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=voxaid-audio
R2_ENDPOINT=https://[ACCOUNT_ID].r2.cloudflarestorage.com

# --- Maps (Leaflet + OpenStreetMap) ---
# No API key needed — uses free OpenStreetMap tiles

# --- Email (Resend) ---
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_...

# --- API Config ---
# Local defaults below. In production (AWS), override with your deployed URLs:
#   API_BASE_URL=http://<EC2_IP>:3001
#   ML_SERVICE_URL=http://ml:8001   (Docker internal) or http://<EC2_IP>:8001
API_BASE_URL=http://localhost:3001
API_PORT=3001
ML_SERVICE_URL=http://localhost:8001

# --- Security ---
# Shared secret between Next.js and NestJS API (generate with: openssl rand -hex 32)
API_SECRET_KEY=change-me-to-a-random-secret
# Comma-separated allowed CORS origins for the API
CORS_ORIGINS=http://localhost:3000

# --- Web → API URL (server-only, used by Next.js rewrites and SSR fetching) ---
API_URL=http://localhost:3001
