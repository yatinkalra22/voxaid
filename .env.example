# =============================================================================
# VoxAID Environment Variables
# Copy this file to .env.local and fill in all values
# =============================================================================

# --- Database (Supabase Postgres) ---
# Get from: https://supabase.com/dashboard → Project Settings → Database
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# --- Auth (Clerk) ---
# Get from: https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- Voice (Twilio) ---
# Get from: https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# --- ASR (OpenAI Whisper) ---
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# --- LLM (Anthropic Claude) ---
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- TTS (ElevenLabs) ---
# Get from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=...

# --- File Storage (Cloudflare R2) ---
# Get from: https://dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=voxaid-audio
R2_ENDPOINT=https://[ACCOUNT_ID].r2.cloudflarestorage.com

# --- Queue (Upstash Redis) ---
# Get from: https://console.upstash.com → Redis → Details
UPSTASH_REDIS_URL=rediss://default:...@...-us1-redis.upstash.io:6379

# --- Maps (Mapbox) ---
# Get from: https://account.mapbox.com/access-tokens
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ...

# --- Email (Resend) ---
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_...

# --- API Config ---
# Set to your ngrok/Render URL for Twilio webhooks
API_BASE_URL=http://localhost:3001
API_PORT=3001
ML_SERVICE_URL=http://localhost:8001

# --- Security ---
# Shared secret between Next.js and NestJS API (generate with: openssl rand -hex 32)
API_SECRET_KEY=change-me-to-a-random-secret
# Comma-separated allowed CORS origins for the API
CORS_ORIGINS=http://localhost:3000

# --- Web → API URL (server-only, used by Next.js rewrites and SSR fetching) ---
API_URL=http://localhost:3001
