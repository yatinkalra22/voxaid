{
  "name": "voxaid",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@voxaid/web",
    "dev:api": "turbo dev --filter=@voxaid/api",
    "dev:all": "./scripts/dev.sh",
    "build": "turbo build",
    "build:web": "turbo build --filter=@voxaid/web",
    "build:api": "turbo build --filter=@voxaid/api",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "setup": "./scripts/setup.sh",
    "deploy": "./scripts/deploy.sh",
    "deploy:web": "./scripts/deploy.sh web",
    "deploy:backend": "./scripts/deploy.sh backend",
    "db:migrate": "./scripts/db-migrate.sh dev",
    "db:deploy": "./scripts/db-migrate.sh deploy",
    "db:studio": "./scripts/db-migrate.sh studio",
    "db:seed": "cd apps/api && npx prisma db seed"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
